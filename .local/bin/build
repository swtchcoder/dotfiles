#!/usr/bin/env bash
set -e

_() {
	COMMAND="$1"
	shift
	for filename in "$@"; do
		if [ -f "$filename" ]; then
			$COMMAND
			exit $?
		fi
	done
}

_ "make -j$(nproc)" "Makefile" "makefile" "GNUmakefile"
_ "./configure && make -j$(nproc)" "configure"
_ "meson setup build && ninja -C build" "meson.build"
_ "ninja" "build.ninja"

read -p "build command: " COMMAND
$COMMAND
